{
  "name": "attack-shapes",
  "description": "#649 step 2: does picking an attack shape at each play-the-ball (forward pod, edge shift, back door or the plain spread; shapes.on) vary the first receiver and spread the try origins without moving the §7 counts, completion or the six preset rows out of 45–55%? Baseline is the off value (shapes.on 0, the weighted receiver on as shipped); 'on' is the proposed default. 'on, no hold' drops the shape as the ball is played (shapes.holdTicks 0), to show what holding it into the first pass adds; 'on, flat weights' gives every preset Balanced's weights, to show what the preset weighting does to the preset rows. The scenarios are standard.json's, with 60 matches on the plain rows.",
  "seeds": 60,
  "base": { "shapes.on": 0 },
  "scenarios": [
    { "name": "even 60 v 60", "home": { "rating": 60 }, "away": { "rating": 60 } },
    { "name": "stamina 30 v 80", "home": { "rating": 60, "stats": { "stamina": 30 } }, "away": { "rating": 60, "stats": { "stamina": 80 } } },
    { "name": "slide v rush", "home": { "rating": 60 }, "away": { "rating": 60, "tactics": { "defence": "rush" } } },
    { "name": "expansive v grind", "home": { "rating": 60, "tactics": { "attack": "expansive" } }, "away": { "rating": 60, "tactics": { "attack": "grind" } } },
    { "name": "grind v balanced", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "attack": "grind" } }, "away": { "rating": 60 } },
    { "name": "expansive v balanced", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "attack": "expansive" } }, "away": { "rating": 60 } },
    { "name": "kick-chase v balanced", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "attack": "kick-chase" } }, "away": { "rating": 60 } },
    { "name": "all-out v balanced", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "attack": "all-out" } }, "away": { "rating": 60 } },
    { "name": "rush v slide", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "defence": "rush" } }, "away": { "rating": 60 } },
    { "name": "compressed v slide", "seeds": 100, "track": "home", "bothWays": true, "home": { "rating": 60, "tactics": { "defence": "compressed" } }, "away": { "rating": 60 } },
    { "name": "70 v 50", "home": { "rating": 70 }, "away": { "rating": 50 } },
    { "name": "fliers v stayers", "home": { "rating": 60, "stats": { "speed": 85, "stamina": 30 } }, "away": { "rating": 60, "stats": { "speed": 65, "stamina": 80 } } },
    { "name": "last 6 min on late legs", "home": { "rating": 60 }, "away": { "rating": 60 }, "legs": "late", "minutes": 6 }
  ],
  "variants": [
    { "name": "on", "tuning": { "shapes.on": 1 } },
    { "name": "on, no hold", "tuning": { "shapes.on": 1, "shapes.holdTicks": 0 } },
    { "name": "on, flat weights", "tuning": {
      "shapes.on": 1,
      "shapes.weights.grind.spread": 1, "shapes.weights.grind.pod": 1, "shapes.weights.grind.edge": 1, "shapes.weights.grind.backDoor": 1,
      "shapes.weights.expansive.spread": 1, "shapes.weights.expansive.pod": 1, "shapes.weights.expansive.edge": 1, "shapes.weights.expansive.backDoor": 1,
      "shapes.weights.kick-chase.spread": 1, "shapes.weights.kick-chase.pod": 1, "shapes.weights.kick-chase.edge": 1, "shapes.weights.kick-chase.backDoor": 1,
      "shapes.weights.all-out.spread": 1, "shapes.weights.all-out.pod": 1, "shapes.weights.all-out.edge": 1, "shapes.weights.all-out.backDoor": 1
    } }
  ]
}
